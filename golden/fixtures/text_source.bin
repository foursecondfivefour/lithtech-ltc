uint32 CLZSSWindow::AddNode(uint32 nNode)
{
    uint32 nCurrNode = m_nRoot;
    while (nCurrNode != NULL_NODE) {
        if (nCurrNode == nNode) { ReplaceNode(nNode); return nCurrNode; }
        nCurrNode = m_Tree[nCurrNode];
    }
    return NULL_NODE;
}

uint32 CLZSSWindow::AddNode(uint32 nNode)
{
    uint32 nCurrNode = m_nRoot;
    while (nCurrNode != NULL_NODE) {
        if (nCurrNode == nNode) { ReplaceNode(nNode); return nCurrNode; }
        nCurrNode = m_Tree[nCurrNode];
    }
    return NULL_NODE;
}

